{
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write '**/*.{vue, ts, js, json, md, mdx}';",
    "lint:scripts": "vue-cli-service lint --no-fix",
    "lint:styles": "stylelint '**/*.{vue, css, scss}'; exit 0",
    "lint:styles:fix": "stylelint --fix '**/*.{vue, css, scss}'; exit 0",
    "preview": "vite preview",
    "test:components": "playwright test -c playwright-components.config.ts",
    "test:types": "tsgo -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.app.json --noEmit",
    "test:sfc": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-vue": "^1.27.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "@typescript/native-preview": "7.0.0-dev.20260627.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/cli-plugin-eslint": "~5.0.4",
    "@vue/cli-service": "~5.0.4",
    "@vue/eslint-config-typescript": "10.0.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.2",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.17.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^9.1.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "prettier": "^2.6.2",
    "stylelint": "^14.9.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^26.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  }
}
